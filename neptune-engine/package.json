{
  "name": "@neptune/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Neptune agent runtime kernel. Houses the SDK wrapper, provider adapters, permissions, storage, hooks, EventBus, and CC runtime without product-layer reverse dependencies.",
  "engines": {
    "bun": ">=1.2.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts",
    "./session": "./src/session.ts",
    "./log": "./src/log.ts",
    "./permissions": "./src/permissions.ts",
    "./storage": "./src/storage.ts",
    "./events": "./src/events.ts",
    "./testing": "./src/testing.ts"
  },
  "dependencies": {
    "@neptune/engine-tools": "workspace:*",
    "@neptune/mcp-client": "workspace:*",
    "@anthropic-ai/sdk": "^0.80.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^6.0.2"
  }
}
