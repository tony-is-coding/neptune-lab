# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/neptune_ai

# Redis 配置
REDIS_URL=redis://localhost:6380

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# LLM API 配置（Agent Engine 所需，支持 Anthropic/GLM 等兼容 API）
NEPTUNE_LLM_API_KEY=your-llm-api-key
NEPTUNE_LLM_BASE_URL=
NEPTUNE_LLM_MODEL=

# 服务配置
PORT=3000
HOST=0.0.0.0

# 日志级别
LOG_LEVEL=info

# 数据存储路径（开发环境使用项目目录，生产环境可使用 /data）
DATA_ROOT=./data

# Langfuse 可观测性（可选，不配置时静默降级为 NoOp）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
