{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "types": ["bun-types"],
    "paths": {
      "src/*": ["./src/*", "../neptune-engine/src/*"],
      "claude-code-best/*": ["../neptune-engine/src/*"],
      "claude-code-best": ["../neptune-engine/src/index.ts"],
      "@claude-code-best/builtin-tools/*": ["../neptune-engine/packages/builtin-tools/src/*"],
      "@claude-code-best/builtin-tools": ["../neptune-engine/packages/builtin-tools/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
